# Maintainer: dax
#
# Generated from anomalyco/rune examples/hokum/packaging/aur by
# examples/hokum/scripts/release-aur.sh, which sets pkgver and the checksums
# of the GitHub release's linux-x64 and linux-arm64 tarballs.
#
# Like dunst and xfce4-notifyd it provides notification-daemon. Like mako,
# dunst, and swaync it installs its D-Bus activation file under its own name,
# so it shares no file with them and conflicts with none: whichever daemon
# runs first owns org.freedesktop.Notifications, and hokum.service stops
# mako, dunst, and swaync when it starts.
pkgname=hokum-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='Hokum: a freedesktop notification daemon for Wayland layer-shell compositors'
arch=('x86_64' 'aarch64')
url='https://hokum.app'
license=('MIT')
provides=('hokum' 'notification-daemon')
conflicts=('hokum')
# Linked: glibc, libgcc. Loaded at run time (so namcap calls them unneeded):
# the Vulkan loader and a driver, the Wayland client library, and xkbcommon.
depends=('glibc' 'libgcc' 'libxkbcommon' 'vulkan-driver' 'vulkan-icd-loader' 'wayland')
options=('!strip' '!debug')
install=hokum-bin.install
_release=https://github.com/anomalyco/rune/releases/download/hokum-v${pkgver}
source_x86_64=("hokum-${pkgver}-linux-x64.tar.gz::${_release}/hokum-${pkgver}-linux-x64.tar.gz")
source_aarch64=("hokum-${pkgver}-linux-arm64.tar.gz::${_release}/hokum-${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=('@SHA256_X64@')
sha256sums_aarch64=('@SHA256_ARM64@')

package() {
  local target=x64
  [ "$CARCH" = aarch64 ] && target=arm64
  cd "hokum-${pkgver}-linux-${target}"
  install -Dm755 hokum "$pkgdir/usr/bin/hokum"
  install -Dm644 hokum.service "$pkgdir/usr/lib/systemd/user/hokum.service"
  install -Dm644 app.hokum.Notifications.service \
    "$pkgdir/usr/share/dbus-1/services/app.hokum.Notifications.service"
  install -Dm644 hokum.desktop "$pkgdir/usr/share/applications/hokum.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
